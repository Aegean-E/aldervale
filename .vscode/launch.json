{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ALDERVALE: Play",
      "type": "debugpy",
      "request": "launch",
      "module": "aldervale",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ALDERVALE: Demo (9s)",
      "type": "debugpy",
      "request": "launch",
      "module": "aldervale",
      "args": ["--demo", "9"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
